{
  "appId": "gr.belowthefold.support",
  "productName": "BTF Support",
  "directories": {
    "output": "dist/desktop",
    "app": "."
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/assets/**/*"
  ],
  "extraMetadata": {
    "main": "desktop/main.cjs"
  },
  "mac": {
    "category": "public.app-category.business",
    "icon": "desktop/assets/icon.png",
    "target": ["dmg", "zip"],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "desktop/entitlements.mac.plist",
    "entitlementsInherit": "desktop/entitlements.mac.inherit.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "BTF Support uses your microphone for team voice huddles.",
      "NSCameraUsageDescription": "BTF Support uses your camera for team video huddles."
    }
  },
  "protocols": [
    {
      "name": "BTF Support",
      "schemes": ["btf-support"]
    }
  ]
}
