{
  "appId": "gr.belowthefold.support",
  "productName": "BTF Support",
  "directories": {
    "output": "dist/desktop",
    "app": "."
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/updater.cjs",
    "desktop/assets/**/*"
  ],
  "artifactName": "BTF-Support-${version}-${arch}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "evankardamitsis",
      "repo": "support_system_btf",
      "releaseType": "release"
    }
  ],
  "extraMetadata": {
    "main": "desktop/main.cjs"
  },
  "afterPack": "./desktop/after-pack.cjs",
  "mac": {
    "category": "public.app-category.business",
    "icon": "desktop/assets/icon.png",
    "target": ["dmg", "zip"],
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "BTF Support uses your microphone for team voice huddles.",
      "NSCameraUsageDescription": "BTF Support uses your camera for team video huddles."
    }
  },
  "protocols": [
    {
      "name": "BTF Support",
      "schemes": ["btf-support"]
    }
  ]
}
