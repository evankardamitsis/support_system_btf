{
  "name": "support_system_btf",
  "version": "0.1.1",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=development electron .",
    "desktop:pack": "electron-builder --mac --dir -c desktop/electron-builder.json",
    "desktop:dist": "env -u ELECTRON_RUN_AS_NODE CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c desktop/electron-builder.json",
    "desktop:upload": "node --env-file=.env.local scripts/upload-macos-desktop.mjs",
    "desktop:release": "npm run desktop:dist && npm run desktop:upload"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@base-ui/react": "^1.5.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@react-pdf/renderer": "^4.5.1",
    "@stream-io/node-sdk": "^0.7.59",
    "@stream-io/video-react-sdk": "^1.37.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "stream-chat": "^9.45.1",
    "stream-chat-react": "^14.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^36.9.5",
    "electron-builder": "24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "supabase": "^2.104.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
